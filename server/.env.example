# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Required: long random string (generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_SECRET_KEY=

# Required: Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Required: owner API key used by the bot for internal API calls
OWNER_API_KEY=

# Required: Neon/Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname

# Your Telegram numeric user ID (get it from @userinfobot on Telegram)
# Comma-separated for multiple users later: 123456,789012
ALLOWED_TELEGRAM_IDS=

# Optional
PORT=8000
DEBUG=true
